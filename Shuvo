}

void dashboard(int role, const char name[])
{
    int choice, max;

    while (1)
    {
        header("CONTROL DASHBOARD");
        printKeyValRow("Logged in as", name, BOLD GREEN);
        printKeyValRow("Access Role", roleNames[role], BOLD YELLOW);
        printMidBorder();

        if (role == 1)
        {
            printLeftRow(BOLD CYAN, "ADMINISTRATION");
            printMidBorder();
            menuLine(1, "Manage Users");
            menuLine(2, "All Vehicles");
            menuLine(3, "Staff & Salary");
            menuLine(4, "Reports");
            max = 4;
        }
        else if (role == 2)
        {
            printLeftRow(BOLD CYAN, "WORKSHOP OPERATIONS");
            printMidBorder();
            menuLine(1, "My Job List");
            menuLine(2, "Update Job Status");
            menuLine(3, "Request Spare Parts");
            max = 3;
        }
        else if (role == 3)
        {
            printLeftRow(BOLD CYAN, "FRONT DESK");
            printMidBorder();
            menuLine(1, "Register Vehicle");
            menuLine(2, "Book Appointment");
            menuLine(3, "Billing & Payment");
            max = 3;
        }
        else
        {
            printLeftRow(BOLD CYAN, "CUSTOMER PORTAL");
            printMidBorder();
            menuLine(1, "My Vehicles");
            menuLine(2, "Book a Service");
            menuLine(3, "Service History");
            max = 3;
        }

        printMidBorder();
        menuLine(0, "Logout");
        menuBoxEnd();

        choice = getChoice();

        if (choice == 0)
        {
            printf("\n");
            showInfo("Logged out safely.");
            waitForKey();
            return;
        }
        else if (choice < 1 || choice > max)
        {
            printf("\n");
            showError("Invalid menu option!");
            waitForKey();
        }
        else if (role == 1 && choice == 1)
        {
            showAllUsers();
        }
        else
        {
            printf("\n");
            showInfo("This module is scheduled for a future update.");
            waitForKey();
        }
    }
}

/* ====================================================== */
/*                         LOGIN                          */
/* ====================================================== */

void loginUser(int role)
{
    char name[30], pass[30], ans[30];
    int idx, wrong = 0, loggedIn = 0, tries;

    header("ACCOUNT LOGIN");
    printKeyValRow("Role", roleNames[role], BOLD YELLOW);
    printLeftRow(DIM WHITE, "Enter '0' as username to return to the role menu.");
    printBottomBorder();
    printf("\n");

    printf(BOLD "  Username : " RESET);
    if (scanf("%29s", name) != 1)
    {
        flushLine();
        return;
    }
    flushLine();

    if (strcmp(name, "0") == 0)
    {
        return;
    }

    idx = findUser(name);
    if (idx == -1 || users[idx].role != role)
    {
        printf("\n");
        showError("No account found with that username for this role.");
        waitForKey();
        return;
    }

    while (wrong < 3)
    {
        printf(BOLD "  Password : " RESET);
        fflush(stdout);
        readPassword(pass, 30);

        if (strcmp(pass, users[idx].password) == 0)
        {
            loggedIn = 1;
            break;
        }
        wrong++;
        showError("Incorrect password!");
        printf(YELLOW "      Attempts remaining: %d\n\n" RESET, 3 - wrong);
    }

    if (loggedIn == 0)
    {
        int qIndex = users[idx].qno;
        if (qIndex < 0 || qIndex > 3)
        {
            qIndex = 0;
        }

        printf("\n");
        showError("Too many failed password attempts.");
        showInfo("Complete security verification to reset your password.\n");
        printf(BOLD CYAN "  Security Question: " RESET BOLD "%s\n" RESET, questions[qIndex]);

        for (tries = 1; tries <= 2; tries++)
        {
            printf(BOLD "  Your Answer (Attempt %d/2): " RESET, tries);
            if (scanf("%29s", ans) != 1)
            {
                flushLine();
                continue;
            }
            flushLine();
            toLowerStr(ans);

            if (strcmp(ans, users[idx].answer) == 0)
            {
                loggedIn = 1;
                break;
            }
            showError("Incorrect answer.\n");
        }

        if (loggedIn == 0)
        {
            printf("\n");
            showError("Identity verification failed. Returning to menu.");
            waitForKey();
            return;
        }

        printf("\n");
        showOk("Identity verified! Please set a new password.\n");
        askNewPassword(users[idx].password);
        saveUsers();
        printf("\n");
        showOk("Password updated successfully!");
    }

    printf("\n");
    showOk("Login successful! Welcome back.");
    waitForKey();
    dashboard(role, users[idx].name);
}

