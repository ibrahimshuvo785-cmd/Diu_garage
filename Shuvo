        waitForKey();
        return;
    }

    printf(BOLD CYAN "  %-4s  %-16s  %-14s  %-28s\n" RESET, "No.", "Username", "Role", "Email");
    printf(DIM "  --------------------------------------------------------------------\n" RESET);
