/*                        MENUS                           */
/* ====================================================== */

void roleMenu(int role)
{
    int choice;
    char titleBuf[60];
    snprintf(titleBuf, sizeof(titleBuf), "%s PORTAL", roleNames[role]);

    while (1)
    {
        header(titleBuf);
        menuBoxStart("AUTHENTICATION");
        menuLine(1, "Login to existing account");
        menuLine(2, "Create new account");
        printMidBorder();
        menuLine(0, "Back to main menu");
        menuBoxEnd();

        choice = getChoice();

        if (choice == 0)
        {
            return;
        }
        else if (choice == 1)
        {
            loginUser(role);
        }
        else if (choice == 2)
        {
            registerUser(role);
        }
        else
        {
            printf("\n");
            showError("Invalid choice! Please select 0, 1, or 2.");
            waitForKey();
        }
    }
}

int main()
{
    int choice;

    loadUsers();

    while (1)
    {
        header("MAIN MENU - SELECT YOUR ROLE");
        menuBoxStart("AVAILABLE ROLES");
        menuLine(1, "Admin");
        menuLine(2, "Mechanic");
        menuLine(3, "Receptionist");
        menuLine(4, "Customer");
        printMidBorder();
        menuLine(0, "Exit");
        menuBoxEnd();

        choice = getChoice();

        if (choice == 0)
        {
            clearScreen();
            printTopBorder();
            printEmptyRow();
            printCentered(BOLD GREEN, "Thank you for using Garage Management System!");
            printCentered(DIM WHITE, "Drive safe - See you next time.");
            printEmptyRow();
            printBottomBorder();
            printf("\n");
            break;
        }
        else if (choice >= 1 && choice <= 4)
        {
            roleMenu(choice);
        }
        else
        {
            printf("\n");
            showError("Invalid choice! Enter a number from 0 to 4.");
            waitForKey();
        }
    }
    return 0;
}
